# Development placeholders only — never commit real secrets

# Public application origin (no trailing slash)
# Local development:
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
CLIENT_ORIGIN="http://localhost:3000"
# Production / Hostinger (set in the host panel — do not commit real secrets):
# APP_URL="https://justgolib.com"
# NEXT_PUBLIC_APP_URL="https://justgolib.com"
# NEXTAUTH_URL="https://justgolib.com"
# CLIENT_ORIGIN="https://justgolib.com"
# NEXTAUTH_URL is unused by this app (no NextAuth); safe to set if the host requires it.

# Supabase PostgreSQL (Prisma provider = postgresql)
# Transaction pooler (port 6543) for the running app:
DATABASE_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler (port 5432) for prisma migrate:
DIRECT_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres"

SESSION_SECRET="replace-with-long-random-session-secret"
# Required in production for /api/admin/* (temporary development guard; not operator auth)
ADMIN_DEV_GUARD_SECRET="replace-with-admin-dev-guard-secret"
# HMAC secret for payment-provider wallet credit callbacks
PAYMENT_WEBHOOK_SECRET="replace-with-payment-webhook-secret"
# Explicit development-only mock recharge (must be false/absent in production)
WALLET_MOCK_PROVIDER="false"
NODE_ENV=development
# Production / Hostinger:
# NODE_ENV=production
# WALLET_MOCK_PROVIDER=false

# Payment / SMS — placeholders only (not operational integrations)
ORANGE_CLIENT_ID="your-orange-client-id"
ORANGE_CLIENT_SECRET="your-orange-client-secret"
ORANGE_SMS_SENDER="JUSTGO"
MTN_MOMO_SUBSCRIPTION_KEY="your-mtn-subscription-key"
MTN_MOMO_API_USER="your-mtn-api-user"
MTN_MOMO_API_KEY="your-mtn-momo-api-key"
ORANGE_MONEY_MERCHANT_KEY="your-orange-money-merchant-key"
CARD_HOSTED_PROVIDER_KEY="your-pci-hosted-provider-key"
